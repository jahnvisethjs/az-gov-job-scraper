# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Select LLM Provider: "gemini" or "asu_ai"
LLM_PROVIDER=gemini

# Google Gemini API Configuration (default provider)
GEMINI_API_KEY=your_gemini_api_key_here

# ASU AI Platform Configuration (optional)
ASU_AI_ENABLED=false
ASU_AI_API_KEY=your_asu_ai_token_here
ASU_AI_BASE_URL=https://api-main.aiml.asu.edu
ASU_AI_MODEL=gpt-4o-mini

# Optional: For future enhancements
# SERPAPI_KEY=your_serpapi_key_here
